# ─────────────────────────────────────────────────────────────
# Configuration sensible — copier ce fichier en `.env` puis remplir.
# Le vrai `.env` est ignoré par git : NE JAMAIS le commiter.
# ─────────────────────────────────────────────────────────────

# Clés API du chatbot IA (renseigner seulement les providers utilisés ;
# gestion à chaud possible via la commande `?davai key set <provider> <clé>`)
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
HHAODUMIAI_API_KEY=
MERCURY_API_KEY=

# Optionnel : en-têtes de déférence OpenRouter
# OPENROUTER_HTTP_REFERER=https://github.com/dav/DavidBot
# OPENROUTER_X_TITLE=DavidBot

# Optionnel : Supabase (sauvegarde distante de l'état d'auth WhatsApp)
# SUPABASE_URL=
# SUPABASE_KEY=

# Optionnel : URL de keep-alive (Render/Railway...). Vide = pas de ping.
DAVID_KEEPALIVE_URL=
